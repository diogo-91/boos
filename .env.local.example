NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Painel do Supabase > Settings > API > service_role key. NUNCA prefixar com
# NEXT_PUBLIC_ — precisa ficar só no servidor. Usada pelas rotas/serviços do
# Drive que rodam automação/server-side, pra funcionarem quando RLS estiver
# ativado nas tabelas.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Precisa ser uma pasta dentro de uma Shared Drive (ou a própria Shared Drive)
# compartilhada com GOOGLE_CLIENT_EMAIL. Contas de serviço não têm cota de
# armazenamento em "Meu Drive" comum — ver docs/documentacao-tecnica.md.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
NEXT_PUBLIC_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEETS_ID=
DRIVE_SYNC_SECRET=
# Google AI Studio (aistudio.google.com) > Get API key.
GEMINI_API_KEY=
